@ARTICLE{Willeke2026-uu,
  title         = "{OmniMouse}: Scaling properties of multi-modal, multi-task
                   Brain Models on {150B} Neural Tokens",
  author        = "Willeke, Konstantin F and Turishcheva, Polina and Gilbert,
                   Alex and Chakrabarty, Goirik and Bedel, Hasan A and Fahey,
                   Paul G and Qiu, Yongrong and Weis, Marissa A and Vystrčilová,

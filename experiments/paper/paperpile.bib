@ARTICLE{Raccuglia2019-ln,
  title     = "Network-specific synchronization of electrical slow-wave
               oscillations regulates sleep drive in Drosophila",
  author    = "Raccuglia, Davide and Huang, Sheng and Ender, Anatoli and Heim,

@ARTICLE{Tanaka2025-ea,
  title     = "On analogies in vertebrate and insect visual systems",
  author    = "Tanaka, Ryosuke and Portugues, Ruben",
  journal   = "Nat. Rev. Neurosci.",
  publisher = "Nature Publishing Group",
  pages     = "1--20",
  abstract  = "Despite the large evolutionary distance between vertebrates and
               insects, the visual systems of these two taxa bear remarkable
               similarities that have been noted repeatedly, including by
               pioneering neuroanatomists such as Ramón y Cajal. Fuelled by the
               advent of transgenic approaches in neuroscience, studies of
               visual system anatomy and function in both vertebrates and
               insects have made dramatic progress during the past two decades,
               revealing even deeper analogies between their visual systems than

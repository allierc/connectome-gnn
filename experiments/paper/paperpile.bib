@ARTICLE{Zhao2022-zu,
  title       = "Eye structure shapes neuron function in Drosophila motion
                 vision",
  author      = "Zhao, Arthur and Gruntman, Eyal and Nern, Aljoscha and Iyer,
                 Nirmala A and Rogers, Edward M and Koskela, Sanna and
                 Siwanowicz, Igor and Dreher, Marisa and Flynn, Miriam A and
                 Laughland, Connor W and Ludwig, Henrique D F and Thomson, Alex
                 G and Moran, Cullen P and Gezahegn, Bruck and Bock, Davi D and

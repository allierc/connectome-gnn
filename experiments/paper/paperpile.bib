  author        = "Lueckmann, Jan-Matthis and Jain, Viren and Januszewski,
                   Michał",
  journal       = "arXiv [q-bio.NC]",
  abstract      = "Constructing mechanistic models of neural circuits is a
                   fundamental goal of neuroscience, yet verifying such models
                   is limited by the lack of ground truth. To rigorously test
                   model discovery, we establish an in silico testbed using
                   neuromechanical simulations of a larval zebrafish as a

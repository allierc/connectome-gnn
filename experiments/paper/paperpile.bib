@ARTICLE{Volgushev2015-lu,
  title    = "Identifying and tracking simulated synaptic inputs from neuronal
              firing: insights from in vitro experiments",
  author   = "Volgushev, Maxim and Ilin, Vladimir and Stevenson, Ian H",
  journal  = "PLoS Comput. Biol.",
  volume   =  11,
  number   =  3,
  pages    = "e1004167",
  abstract = "Accurately describing synaptic interactions between neurons and
              how interactions change over time are key challenges for systems
              neuroscience. Although intracellular electrophysiology is a
              powerful tool for studying synaptic integration and plasticity, it
              is limited by the small number of neurons that can be recorded

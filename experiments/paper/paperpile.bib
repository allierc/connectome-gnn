@ARTICLE{Smith2019-jc,
  title     = "Single-cell transcriptomic evidence for dense intracortical
               neuropeptide networks",
  author    = "Smith, Stephen J and Sümbül, Uygar and Graybuck, Lucas T and
               Collman, Forrest and Seshamani, Sharmishtaa and Gala, Rohan and

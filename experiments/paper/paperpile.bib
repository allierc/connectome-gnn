}

@ARTICLE{Chen2026-mm,
  title         = "{BrainFuse}: a unified infrastructure integrating realistic
                   biological modeling and core {AI} methodology",
  author        = "Chen, Baiyu and Wu, Yujie and Xu, Siyuan and Qu, Peng and Wu,

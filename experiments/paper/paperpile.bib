@ARTICLE{Kar2019-da,
  title     = "Evidence that recurrent circuits are critical to the ventral
               stream's execution of core object recognition behavior",
  author    = "Kar, Kohitij and Kubilius, Jonas and Schmidt, Kailyn and Issa,

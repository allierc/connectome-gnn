@misc{ackerman_data_2024,
	title = {Data {Release}: {High}-{Resolution} {Imaging} and {Segmentation} of {P7} {Mouse} {Tissue} {Microarchitecture} {Using} {FIB}-{SEM} and {Machine} {Learning}},

	journal = {Physical Review Letters},
	publisher = {American Physical Society},
	author = {Vicsek, Tamás and Czirók, András and Ben-Jacob, Eshel and Cohen, Inon and Shochet, Ofer},
	month = aug,
	year = {1995},
	pages = {1226--1229},
}


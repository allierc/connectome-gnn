# Data root config (per-environment, not tracked)
data_paths.json

# Track only biomodel config folders (fly, drosophila_cx, larva, zebrafish_oculomotor)
config/*
!config/fly/
# Root config/fly/*.yaml IS tracked: those are the live experiment specs. The
# archive_* folders are superseded grids kept only for provenance -- ignored as
# whole directories, so git does not descend into them.
config/fly/archive*/

# Ignore LLM-generated config files (environment-specific, stored in GraphData)
config/**/*_Claude_*.yaml
config/**/*_winner.yaml

# Always track flyvis_hybrid_flywireRF configs, even in archive folders
!config/fly/flyvis_hybrid_flywireRF_*.yaml
!config/fly/archive/flyvis_hybrid_flywireRF_*.yaml
!config/fly/archive_2/flyvis_hybrid_flywireRF_*.yaml

# Data files (large simulation data)
*.npy
*.npz
*.pth
*.backup
paper/
# Ignore papers/ except Code_NN (biomodel data generation scripts)
papers/*
!papers/Code_NN/
!papers/*.md
papers/Code_NN/Code_NN/Data/Figure[1-4]/
papers/Code_NN/Code_NN/Data/Figure5/*.npz
papers/Code_NN/Code_NN/Data/Figure5/*.pt
papers/Code_NN/Code_NN/.png
papers/Code_NN/Code_NN/**/.DS_Store
papers/Code_NN/__MACOSX/

# Log folder — nothing tracked
log/

# Ignore edge_index.pt and mask.pt everywhere (recreated from connectivity)
**/edge_index.pt
**/mask.pt

# Hybrid connectome tables
data/hybrid_connectomes/
data/archive

# graphs_data: large generated data, not tracked
graphs_data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# IDE
.devcontainer/
.idea/
.vscode/
*.swp
*.swo
.env
.prettierrc.json

# Benchmark / one-off run scripts (root level only)
run_*.py
test_edge_removal.py
test_null_edges.py
plot_benchmark*.py
plot_edge_removal.py
plot_null_edges_all_metrics.py
plot_two_panel.py
refactor.md

# Local-only scripts + figure outputs
scripts/
# Track only source code in figures/ (.py / .md / .tex); ignore rendered outputs (PDF/PNG/JPG)
figures/*
!figures/*.py
!figures/*.md
!figures/*.tex
# Source code under the per-biomodel subfolders is also tracked.
!figures/drosophila_cx/
figures/drosophila_cx/*
!figures/drosophila_cx/*.py
!figures/drosophila_cx/*.md
!figures/drosophila_cx/*.tex
!figures/zebrafish/
figures/zebrafish/*
!figures/zebrafish/*.py
!figures/zebrafish/*.md
!figures/zebrafish/*.tex
*.png
*.pdf
*.jpg
*.jpeg
# PNG assets needed to compile docs/drosophila.tex
# (referenced via the docs/figure -> ../figures/drosophila_cx symlink).
# These exceptions live after the broad `*.png` rule so they take effect.
!figures/drosophila_cx/fig_connectome_summary.png
!figures/drosophila_cx/fig_cx_anatomy_3d.png
!figures/drosophila_cx/fig_cx_four_classes.png
!figures/drosophila_cx/fig_evolution_drosophila_cx_pi_epg_no_tv_cv0.png
!figures/drosophila_cx/fig_evolution_drosophila_cx_pi_epg_tv_cv0.png
!figures/drosophila_cx/fig_evolution_drosophila_cx_pi_fc_epg_cv0.png
!figures/drosophila_cx/fig_evolution_drosophila_cx_pi_frozen_Wrec_epg_cv0.png
!figures/drosophila_cx/fig_evolution_drosophila_cx_pi_gnn_epg_no_tv_cv0.png
!figures/drosophila_cx/fig_evolution_drosophila_cx_pi_gnn_epg_tv_cv0.png
!figures/drosophila_cx/fig_function_dynamics_combined_epg.png
!figures/drosophila_cx/fig_hd_mi_summary_nbins64.png
!figures/drosophila_cx/fig_kinographs_both_sorts_epg.png
!figures/drosophila_cx/fig_kinographs_const_omega_epg.png
!figures/drosophila_cx/fig_omega_mi_summary_nbins32.png
!figures/drosophila_cx/fig_sparsify_cx.png
!figures/drosophila_cx/fig_traces_combined_epg.png
!figures/drosophila_cx/fig_traces_const_omega_epg.png
!figures/drosophila_cx/fig_w_rec_comparison.png
!figures/drosophila_cx/fig_cx_tuning_sharpness.png

# Code review
flyvis_gnn_code_review*.pdf
code_review_deepmind_v*.py

# LLM exploration (cluster-specific scripts, not tracked)
INR_LLM.py
src/flyvis_gnn/LLM/cluster.py

# LLM instruction directory — track all instruction files
LLM/*
!LLM/instruction_*.md

# OS
.DS_Store
Thumbs.db

# Quarto
/.quarto/
_site/
*.quarto_ipynb
*_files/
*.ipynb

**/*.quarto_ipynb

# Assets (LFS-tracked PNGs/HTMLs)
assets/*.png
assets/*.html

# Docs (latex, pdf, md)

/docs/*.aux
/docs/*.fdb_latexmk
/docs/*.fls
/docs/*.log
/docs/*.out
/docs/*.gz

.github/skills/
docs/repo_overview.md
hpc-config.json*

# prototype/ (dot_tracking, etc.): archive scripts, configs (yaml/tex/pdf); ignore
# renders, checkpoints and large data. *.png/*.pdf/*.npz are already ignored
# globally, so pdf needs an explicit exception to be tracked here.
prototype/**/*.mp4
prototype/**/*.pt
!prototype/**/*.pdf

# Claude code settings
# ignore local settings json that each user can set independently
.claude/settings.local.json
# Generated by tools/bench_throughput.py, one per benchmark run
config/fly/*_bench_*.yaml
